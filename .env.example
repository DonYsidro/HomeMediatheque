# Clés API externes — remplacer par vos propres clés
TMDB_API_KEY=votre_cle_tmdb_ici
GOOGLEBOOKS_API_KEY=votre_cle_googlebooks_ici
DISCOGS_TOKEN=votre_token_discogs_ici

# Sécurité Flask — générer une clé aléatoire propre à chaque installation
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE

# Administration — renseigner le hash scrypt du PIN, jamais le PIN en clair
ADMIN_PIN_HASH=

# Durée de validité de la session administrateur, en minutes
ADMIN_SESSION_MINUTES=30

# Mettre true si l'application est utilisée en HTTPS
SESSION_COOKIE_SECURE=true

# Facultatif : chemin personnalisé de la base SQLite
# DATABASE_PATH=/app/data/mediatheque.db
